[66.981, "o", "\u001b[90m┌─ calcular_ruta en el lado PC ─────────────────────────────────────────────────────────────────────────\u001b[0m\n"]
[66.981, "o", "\u001b[90m 328\u001b[0m\u001b[90m │ \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mcalcular_ruta\u001b[39;49;00m(destino):          \u001b[90m# 'E2.3' -> '1:1:3'\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[67.036, "o", "\u001b[90m 329\u001b[0m\u001b[90m │ \u001b[0m    nivel, eid = parsear_destino(destino)\u001b[90m\u001b[39;49;00m\n"]
[67.091, "o", "\u001b[90m 330\u001b[0m\u001b[90m │ \u001b[0m    tramos = []\u001b[90m\u001b[39;49;00m\n"]
[67.146, "o", "\u001b[90m 331\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mfor\u001b[39;49;00m n \u001b[95min\u001b[39;49;00m \u001b[96mrange\u001b[39;49;00m(nivel, \u001b[94m0\u001b[39;49;00m, -\u001b[94m1\u001b[39;49;00m):\u001b[90m\u001b[39;49;00m\n"]
[67.201, "o", "\u001b[90m 332\u001b[0m\u001b[90m │ \u001b[0m        tramos.insert(\u001b[94m0\u001b[39;49;00m, topologia[\u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mnivel_\u001b[39;49;00m\u001b[33m{\u001b[39;49;00mn-\u001b[94m1\u001b[39;49;00m\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m][\u001b[33m\"\u001b[39;49;00m\u001b[33mpuente_hacia\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m][n])\u001b[90m\u001b[39;49;00m\n"]
[67.256, "o", "\u001b[90m 333\u001b[0m\u001b[90m │ \u001b[0m    tramos.append(eid)\u001b[90m\u001b[39;49;00m\n"]
[67.311, "o", "\u001b[90m 334\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mreturn\u001b[39;49;00m \u001b[33m\"\u001b[39;49;00m\u001b[33m:\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m.join(\u001b[96mmap\u001b[39;49;00m(\u001b[96mstr\u001b[39;49;00m, tramos))\u001b[90m\u001b[39;49;00m\n"]
[67.366, "o", "\u001b[90m└───────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\n"]
