[119.249, "o", "\u001b[90m 284\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00m\u001b[94mconst\u001b[39;49;00m\u001b[90m \u001b[39;49;00mrad\u001b[90m \u001b[39;49;00m=\u001b[90m \u001b[39;49;00mdeg\u001b[90m \u001b[39;49;00m*\u001b[90m \u001b[39;49;00m\u001b[96mMath\u001b[39;49;00m.PI/\u001b[94m180\u001b[39;49;00m;\u001b[90m\u001b[39;49;00m\n"]
