[52.892, "o", "\u001b[90m 261\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00m\u001b[96muint8_t\u001b[39;49;00m\u001b[90m  \u001b[39;49;00mmsg_type;\u001b[90m        \u001b[39;49;00m\u001b[90m// 0 = CMD_DOWN, 1 = RESP_UP\u001b[39;49;00m\n"]
