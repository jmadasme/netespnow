[79.58, "o", "\u001b[90m┌─ gateway_forward: reenvío sin tablas ─────────────────────────────────────────────────────────────────\u001b[0m\n"]
[79.58, "o", "\u001b[90m 340\u001b[0m\u001b[90m │ \u001b[0m\u001b[96mvoid\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mgateway_forward\u001b[39;49;00m(\u001b[96muint8_t\u001b[39;49;00m\u001b[90m \u001b[39;49;00m*ruta,\u001b[90m \u001b[39;49;00m\u001b[96muint8_t\u001b[39;49;00m\u001b[90m \u001b[39;49;00mruta_len,\u001b[90m \u001b[39;49;00mEspNowMessageV14\u001b[90m \u001b[39;49;00m*msg)\u001b[90m \u001b[39;49;00m{\u001b[90m\u001b[39;49;00m\n"]
[79.635, "o", "\u001b[90m 341\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00m\u001b[94mif\u001b[39;49;00m\u001b[90m \u001b[39;49;00m(ruta_len\u001b[90m \u001b[39;49;00m==\u001b[90m \u001b[39;49;00m\u001b[94m0\u001b[39;49;00m)\u001b[90m \u001b[39;49;00m{\u001b[90m \u001b[39;49;00mentregar_local(msg);\u001b[90m \u001b[39;49;00m\u001b[94mreturn\u001b[39;49;00m;\u001b[90m \u001b[39;49;00m}\u001b[90m        \u001b[39;49;00m\u001b[90m// ya llegó\u001b[39;49;00m\n"]
[79.69, "o", "\u001b[90m 342\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[79.745, "o", "\u001b[90m 343\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00m\u001b[96mint\u001b[39;49;00m\u001b[90m \u001b[39;49;00msep\u001b[90m \u001b[39;49;00m=\u001b[90m \u001b[39;49;00mbuscar_dos_puntos(ruta,\u001b[90m \u001b[39;49;00mruta_len);\u001b[90m\u001b[39;49;00m\n"]
[79.8, "o", "\u001b[90m 344\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00m\u001b[96muint8_t\u001b[39;49;00m\u001b[90m \u001b[39;49;00mid\u001b[90m \u001b[39;49;00m=\u001b[90m \u001b[39;49;00mparsear_entero(ruta,\u001b[90m \u001b[39;49;00msep\u001b[90m \u001b[39;49;00m<\u001b[90m \u001b[39;49;00m\u001b[94m0\u001b[39;49;00m\u001b[90m \u001b[39;49;00m?\u001b[90m \u001b[39;49;00mruta_len\u001b[90m \u001b[39;49;00m:\u001b[90m \u001b[39;49;00msep);\u001b[90m\u001b[39;49;00m\n"]
[79.855, "o", "\u001b[90m 345\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[79.91, "o", "\u001b[90m 346\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00mpeer_t\u001b[90m \u001b[39;49;00m*p\u001b[90m \u001b[39;49;00m=\u001b[90m \u001b[39;49;00mbuscar_endpoint(id);\u001b[90m\u001b[39;49;00m\n"]
[79.965, "o", "\u001b[90m 347\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00m\u001b[94mif\u001b[39;49;00m\u001b[90m \u001b[39;49;00m(!p)\u001b[90m \u001b[39;49;00m{\u001b[90m \u001b[39;49;00menviar_error(msg,\u001b[90m \u001b[39;49;00mERR_ENDPOINT_NOT_FOUND,\u001b[90m \u001b[39;49;00mid);\u001b[90m \u001b[39;49;00m\u001b[94mreturn\u001b[39;49;00m;\u001b[90m \u001b[39;49;00m}\u001b[90m\u001b[39;49;00m\n"]
[80.02, "o", "\u001b[90m 348\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[80.075, "o", "\u001b[90m 349\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00m\u001b[94mif\u001b[39;49;00m\u001b[90m \u001b[39;49;00m(sep\u001b[90m \u001b[39;49;00m<\u001b[90m \u001b[39;49;00m\u001b[94m0\u001b[39;49;00m)\u001b[90m \u001b[39;49;00m{\u001b[90m                       \u001b[39;49;00m\u001b[90m// último tramo: entregar\u001b[39;49;00m\n"]
